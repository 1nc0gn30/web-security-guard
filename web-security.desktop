[Desktop Entry]
Version=1.0
Type=Application
Name=Web Security Guard
GenericName=Web Security Audit & Hardening Workstation
Comment=Zero-Dependency Web Security Audit, CSP Builder, SRI Pinning, WCAG Contrast & TLS Inspection
Exec=/usr/local/bin/web-security desktop
Icon=web-security-guard
Terminal=false
Categories=Security;Development;System;Utility;
StartupNotify=true
Actions=CLI;Web;

[Desktop Action CLI]
Name=Open Web Security CLI
Exec=x-terminal-emulator -e "/usr/local/bin/web-security --help"

[Desktop Action Web]
Name=Open Web UI (Port 8125)
Exec=/usr/local/bin/web-security web
